{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Task Categories Schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "معرّف فريد للفئة",
      "pattern": "^cat_[a-z0-9]+$"
    },
    "name_ar": {
      "type": "string",
      "description": "اسم الفئة بالعربية"
    },
    "name_en": {
      "type": "string",
      "description": "اسم الفئة بالإنجليزية"
    },
    "description": {
      "type": "string",
      "description": "وصف الفئة"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-F]{6}$",
      "description": "لون الفئة (hex code)"
    },
    "icon": {
      "type": "string",
      "description": "رمز الفئة"
    }
  },
  "required": ["id", "name_ar", "name_en"]
}
